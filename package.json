{
  "name": "sylvara-guard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create sylvara-guard-db",
    "db:migrate:local": "wrangler d1 execute sylvara-guard-db --local --file=./migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute sylvara-guard-db --remote --file=./migrations/0001_initial.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}